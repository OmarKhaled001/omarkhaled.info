APP_NAME="Omar Khaled"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite. Production: DB_CONNECTION=mysql and fill the DB_* values below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=omarkhaled
# DB_USERNAME=omarkhaled
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS only)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Shared hosting without Supervisor: true lets the scheduler cron run the queue worker.
QUEUE_VIA_SCHEDULER=false

CACHE_STORE=database

# --- Mail -------------------------------------------------------------------
# Local: keep "log" (emails are written to storage/logs/laravel.log, nothing is sent).
# Production default: MAIL_MAILER=resend + RESEND_API_KEY. Postmark alternative: see docs/deployment.md.
MAIL_MAILER=log
RESEND_API_KEY=
# POSTMARK_API_KEY=
MAIL_FROM_ADDRESS="hello@omarkhaled.info"
MAIL_FROM_NAME="${APP_NAME}"
# Fallback recipient for contact-form inquiries when the Site Settings email is still a placeholder.
MAIL_CONTACT_ADDRESS=

# --- Admin panel ------------------------------------------------------------
# Filament path (https://omarkhaled.info/{ADMIN_PATH}). Pick something non-obvious in production.
ADMIN_PATH=admin

# --- Spam protection (optional Cloudflare Turnstile) -------------------------
# Leave empty to disable. Also toggle it on in Admin -> Settings -> Spam.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Full-page response cache ------------------------------------------------
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_LIFETIME=604800

VITE_APP_NAME="${APP_NAME}"
